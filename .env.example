# Copy this file to .env and fill in your values.
# .env is gitignored and must never be committed.

# ---------------------------------------------------------------------------
# Optional API keys (free, recommended). All are unnecessary for first use;
# adding them simply removes the polite-pool rate limits on each service.
# ---------------------------------------------------------------------------

# OpenAlex and Crossref: identify yourself for the polite pool, no signup.
CROSSREF_MAILTO=

# PubMed (NCBI E-utilities): increases rate limit from 3 to 10 req/sec.
# Free key: https://www.ncbi.nlm.nih.gov/account/settings/
NCBI_API_KEY=

# Semantic Scholar: increases rate limit (~1 to ~100 req/sec).
# Free key: https://www.semanticscholar.org/product/api
SEMANTIC_SCHOLAR_API_KEY=

# ---------------------------------------------------------------------------
# Optional: enables the built-in AI analysis features in the workspace
# (landscape analysis, relevance filtering). The app runs fine without it.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=2500
